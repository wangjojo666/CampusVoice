# These values are embedded in browser bundles. Never put secrets in this file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Browser build-time auth topology. For a shared Web + Mini Program API use
# oidc_wechat; for browser-only campus OIDC use oidc. This value is public.
NEXT_PUBLIC_AUTH_MODE=demo

# Optional WebSocket override. By default it is derived from the API base URL.
# NEXT_PUBLIC_ASR_WS_URL=ws://localhost:8000/ws/asr
