<view class="page">
  <view class="page-header">
    <view class="page-header-main">
      <view class="page-kicker">CALENDAR</view>
      <view class="page-title" aria-role="heading">校园日历</view>
      <view class="page-subtitle">看清时间安排，创建前自动检查冲突</view>
    </view>
    <button
      class="primary mini-button"
      aria-label="{{editorOpen ? '收起新建日程表单' : '打开新建日程表单'}}"
      disabled="{{!configured}}"
      bindtap="toggleEditor"
    >{{editorOpen ? '收起' : '新建'}}</button>
  </view>

  <view wx:if="{{!configured && !error}}" class="status-note" aria-label="日历服务尚未连接，连接服务器后即可同步和创建日程">
    <view class="status-icon" aria-hidden="true">!</view>
    <view class="status-content">
      <view class="status-title">日历服务尚未连接</view>
      <view class="status-copy">连接服务器后即可同步和创建日程。</view>
    </view>
  </view>
  <view wx:if="{{error && (events.length || editorOpen)}}" class="status-note error" aria-live="assertive" aria-atomic="true" aria-label="日程操作未完成：{{error}}">
    <view class="status-icon" aria-hidden="true">×</view>
    <view class="status-content">
      <view class="status-title">日程操作未完成</view>
      <view class="status-copy">{{error}}</view>
    </view>
  </view>

  <view wx:if="{{editorOpen}}" class="card editor">
    <view class="card-title" aria-role="heading">新增一小时日程</view>
    <view class="form-help">系统会先检查时间冲突，标有星号的项目为必填项。</view>

    <view class="field-label">日程名称 <text class="required-mark" aria-hidden="true">*</text></view>
    <input
      class="field"
      aria-label="日程名称，必填"
      maxlength="200"
      placeholder="例如：课程小组讨论"
      value="{{form.title}}"
      data-field="title"
      bindinput="updateField"
    />

    <view class="field-label">所属课程</view>
    <input
      class="field"
      aria-label="所属课程，选填"
      maxlength="120"
      placeholder="例如：大学英语"
      value="{{form.course}}"
      data-field="course"
      bindinput="updateField"
    />

    <view class="field-label">地点</view>
    <input
      class="field"
      aria-label="日程地点，选填"
      maxlength="200"
      placeholder="例如：图书馆三楼"
      value="{{form.location}}"
      data-field="location"
      bindinput="updateField"
    />

    <view class="field-label">开始时间</view>
    <view class="form-row">
      <picker
        class="picker"
        aria-label="选择日程开始日期"
        mode="date"
        value="{{form.date}}"
        data-field="date"
        bindchange="updateField"
      >
        <view class="field picker-field"><text>{{form.date}}</text><text class="picker-arrow" aria-hidden="true">⌄</text></view>
      </picker>
      <picker
        class="picker"
        aria-label="选择日程开始时间"
        mode="time"
        value="{{form.time}}"
        data-field="time"
        bindchange="updateField"
      >
        <view class="field picker-field"><text>{{form.time}}</text><text class="picker-arrow" aria-hidden="true">⌄</text></view>
      </picker>
    </view>
    <button class="primary save-button" loading="{{busy}}" disabled="{{!configured || busy}}" bindtap="createEvent">检查冲突并创建</button>
  </view>

  <view class="section-heading calendar-section">
    <view class="section-title" aria-role="heading">近期安排</view>
    <view class="section-caption">{{events.length ? events.length + ' 项' : '接下来'}}</view>
  </view>
  <view wx:if="{{loading && !error}}" class="loading" aria-live="polite" aria-atomic="true" aria-label="正在加载日程">正在加载日程</view>
  <view wx:elif="{{events.length}}">
    <view class="timeline-item" wx:for="{{events}}" wx:key="id">
      <view class="timeline-dot" aria-hidden="true"></view>
      <view
        class="card event-card"
        aria-label="{{item.title}}，{{item.startText}}至{{item.endText}}，{{item.course || '日程'}}，{{item.location || '地点待定'}}"
      >
        <view class="row-between event-heading">
          <view class="card-title event-title">{{item.title}}</view>
          <view class="pill event-course">{{item.course || '日程'}}</view>
        </view>
        <view class="event-time">{{item.startText}}</view>
        <view class="muted event-meta">至 {{item.endText}}</view>
        <view class="location-row"><view class="location-dot" aria-hidden="true"></view><view class="location-text">{{item.location || '地点待定'}}</view></view>
      </view>
    </view>
  </view>
  <view wx:elif="{{!editorOpen}}" class="card empty">
    <view wx:if="{{error}}" aria-label="日程加载失败：{{error}}" aria-live="assertive" aria-atomic="true">
      <view class="empty-icon retry-icon" aria-hidden="true">↻</view>
      <view class="empty-title">暂时无法加载日程</view>
      <view class="empty-copy">{{error}}</view>
      <button class="secondary empty-action" bindtap="retryLoad">重新加载</button>
    </view>
    <block wx:else>
      <view class="empty-icon" aria-hidden="true">○</view>
      <view class="empty-title">{{configured ? '近期没有日程' : '日历尚未同步'}}</view>
      <view class="empty-copy">{{configured ? '安排下一场校园活动，让时间更从容' : '连接服务后显示你的近期安排'}}</view>
      <button wx:if="{{configured}}" class="primary empty-action" bindtap="toggleEditor">新建日程</button>
    </block>
  </view>
</view>