.calendar-section {
  margin-top: 34rpx;
}

.required-mark {
  color: #a9443d;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #607771;
  font-size: 26rpx;
}

.timeline-item {
  position: relative;
  padding-left: 42rpx;
}

.timeline-item::before {
  content: "";
  position: absolute;
  top: 30rpx;
  bottom: -22rpx;
  left: 12rpx;
  width: 2rpx;
  background: #c8d9d4;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  z-index: 1;
  top: 27rpx;
  left: 0;
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  border: 6rpx solid #e2f2ee;
  border-radius: 50%;
  background: #0c7a6c;
}

.event-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.event-heading {
  align-items: flex-start;
}

.event-title {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.event-course {
  max-width: 42%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-time {
  margin-top: 18rpx;
  color: #0b766b;
  font-size: 27rpx;
  font-weight: 700;
}

.event-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.location-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  color: #526d67;
  font-size: 24rpx;
  line-height: 1.55;
}

.location-dot {
  flex-shrink: 0;
  width: 13rpx;
  height: 13rpx;
  margin-top: 10rpx;
  margin-right: 10rpx;
  border: 3rpx solid #7f9d96;
  border-radius: 50%;
}

.location-text,
.status-copy,
.empty-copy {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.empty-action {
  min-width: 220rpx;
  margin: 26rpx auto 0;
  font-size: 25rpx;
}

.retry-icon {
  color: #976029;
  background: #fff0d5;
}

@media (max-width: 360px) {
  .page-header {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .form-row {
    display: block;
  }

  .picker {
    display: block;
    width: 100%;
  }

  .picker + .picker {
    margin-top: 14rpx;
    margin-left: 0;
  }

  .event-heading {
    flex-wrap: wrap;
  }

  .event-course {
    max-width: 100%;
  }
}
