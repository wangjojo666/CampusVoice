.home-page {
  padding-top: 20rpx;
}
.home-hero {
  padding-bottom: 46rpx;
}
.hero-topline {
  display: flex;
  position: relative;
  z-index: 1;
  align-items: center;
  justify-content: space-between;
}
.home-hero .hero-chip {
  flex-shrink: 0;
  margin-top: 0;
  margin-left: 18rpx;
  border-color: #b7ded6;
  color: #0b5f55;
  background: #e8f7f3;
}
.home-status {
  margin-top: 22rpx;
}
.status-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 15rpx;
  color: #76520e;
  background: rgba(244, 217, 147, 0.45);
  font-size: 23rpx;
  font-weight: 700;
}
.status-link-active {
  opacity: 0.72;
}
.status-link-arrow {
  margin-left: 8rpx;
}
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.quick-card {
  box-sizing: border-box;
  position: relative;
  width: 48.6%;
  min-height: 224rpx;
  margin-bottom: 18rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(45, 94, 87, 0.1);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 26rpx rgba(28, 69, 63, 0.06);
  transition:
    transform 140ms ease,
    opacity 140ms ease;
}
.quick-card-active {
  opacity: 0.82;
  transform: scale(0.975);
}
.quick-card.voice {
  background: linear-gradient(145deg, #e8f7f2, #ffffff 72%);
}
.quick-card.task {
  background: linear-gradient(145deg, #eef4ff, #ffffff 72%);
}
.quick-card.calendar {
  background: linear-gradient(145deg, #fff7e7, #ffffff 72%);
}
.quick-card.notice {
  background: linear-gradient(145deg, #fff0ee, #ffffff 72%);
}
.quick-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 18rpx;
  border-radius: 21rpx;
  background: #e2f3ee;
}
.quick-card.task .quick-icon-wrap {
  background: #e6eefc;
}
.quick-card.calendar .quick-icon-wrap {
  background: #f9edd2;
}
.quick-card.notice .quick-icon-wrap {
  background: #f9e4e1;
}
.quick-icon {
  width: 42rpx;
  height: 42rpx;
}
.quick-title {
  color: #173733;
  font-size: 29rpx;
  font-weight: 700;
}
.quick-copy {
  margin-top: 7rpx;
  padding-right: 18rpx;
  color: #526b66;
  font-size: 23rpx;
  line-height: 1.5;
}
.quick-arrow {
  position: absolute;
  right: 21rpx;
  bottom: 19rpx;
  color: #607771;
  font-size: 36rpx;
  line-height: 1;
}
.home-list-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.list-marker {
  flex-shrink: 0;
  width: 9rpx;
  height: 76rpx;
  border-radius: 99rpx;
  background: linear-gradient(180deg, #14a188, #0b7165);
}
.list-content {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.list-title {
  min-width: 0;
  overflow-wrap: break-word;
}
.list-meta {
  margin-top: 7rpx;
  font-size: 24rpx;
}
.date-tile {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  color: #5e6e69;
  background: #f0f5f3;
  font-size: 21rpx;
}
.date-dot {
  width: 16rpx;
  height: 16rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: #0c7a6c;
}
.home-empty {
  margin-bottom: 4rpx;
}
.footer-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 42rpx;
}
.footer-link {
  width: auto;
  min-height: 88rpx;
  padding: 0 20rpx;
  color: #526b66;
  background: transparent;
  font-size: 23rpx;
  font-weight: 600;
}
.footer-divider {
  width: 1rpx;
  height: 24rpx;
  background: #cedbd7;
}

@media (max-width: 350px) {
  .hero-topline,
  .section-heading {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .home-hero .hero-chip {
    margin-top: 12rpx;
    margin-left: 0;
  }

  .quick-card {
    width: 100%;
    min-height: 196rpx;
  }

  .footer-link,
  .status-link {
    min-height: 104rpx;
  }
}
