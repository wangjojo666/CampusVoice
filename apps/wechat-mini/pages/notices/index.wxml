<view class="page">
  <view class="hero compact">
    <view class="hero-kicker">NOTICE RADAR</view>
    <view class="hero-title">校园通知雷达</view>
    <view class="hero-copy">追踪通知版本、截止时间和对现有任务日程的影响。任何迁移仍需人工审核。</view>
  </view>

  <view wx:if="{{!configured}}" class="banner">配置 HTTPS 服务后显示与你相关的校园通知。</view>
  <view wx:if="{{error}}" class="banner">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在扫描通知变化…</view>

  <view wx:elif="{{cards.length}}" class="notice-list">
    <view class="card notice-card {{item.needs_review ? 'review' : ''}}" wx:for="{{cards}}" wx:key="series_id">
      <view class="row-between">
        <view class="pill {{item.needs_review ? 'danger-pill' : ''}}">{{item.typeLabel}}</view>
        <view class="muted time">{{item.createdText}}</view>
      </view>
      <view class="notice-title">{{item.title}}</view>
      <view class="notice-message">{{item.message}}</view>
      <view wx:if="{{item.changeSummary || item.impactSummary}}" class="meta-box">
        <text wx:if="{{item.changeSummary}}">{{item.changeSummary}}</text>
        <text wx:if="{{item.changeSummary && item.impactSummary}}"> · </text>
        <text wx:if="{{item.impactSummary}}">{{item.impactSummary}}</text>
      </view>
      <view wx:if="{{item.deadlineText}}" class="deadline">截止：{{item.deadlineText}}</view>
      <view wx:if="{{item.needs_review}}" class="review-note">需要在完整变更详情中人工核对后再执行。</view>
    </view>
  </view>

  <view wx:else class="card empty">{{configured ? '当前没有新的通知变化' : '服务配置后显示通知雷达'}}</view>
</view>
