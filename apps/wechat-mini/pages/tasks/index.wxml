<view class="page">
  <view class="page-header">
    <view class="page-header-main">
      <view class="page-kicker">TASKS</view>
      <view class="page-title" aria-role="heading">任务清单</view>
      <view class="page-subtitle">把每件事拆成清楚、可完成的下一步</view>
    </view>
    <button
      class="primary mini-button"
      aria-label="{{editorOpen ? '收起新建任务表单' : '打开新建任务表单'}}"
      disabled="{{!configured}}"
      bindtap="toggleEditor"
    >{{editorOpen ? '收起' : '新建'}}</button>
  </view>

  <view wx:if="{{!configured && !error}}" class="status-note" aria-label="任务服务尚未连接，连接服务器后即可同步和创建任务">
    <view class="status-icon" aria-hidden="true">!</view>
    <view class="status-content">
      <view class="status-title">任务服务尚未连接</view>
      <view class="status-copy">连接服务器后即可同步和创建任务。</view>
    </view>
  </view>
  <view wx:if="{{error && (tasks.length || editorOpen)}}" class="status-note error" aria-live="assertive" aria-atomic="true" aria-label="任务操作未完成：{{error}}">
    <view class="status-icon" aria-hidden="true">×</view>
    <view class="status-content">
      <view class="status-title">任务操作未完成</view>
      <view class="status-copy">{{error}}</view>
    </view>
  </view>

  <view wx:if="{{editorOpen}}" class="card editor">
    <view class="card-title" aria-role="heading">新建任务</view>
    <view class="form-help">填写任务信息，标有星号的项目为必填项。</view>

    <view class="field-label">任务名称 <text class="required-mark" aria-hidden="true">*</text></view>
    <input
      class="field"
      aria-label="任务名称，必填"
      maxlength="200"
      placeholder="例如：提交课程报告"
      value="{{form.title}}"
      data-field="title"
      bindinput="updateField"
    />

    <view class="field-label">所属课程</view>
    <input
      class="field"
      aria-label="所属课程，选填"
      maxlength="120"
      placeholder="例如：高等数学"
      value="{{form.course}}"
      data-field="course"
      bindinput="updateField"
    />

    <view class="field-label">截止时间</view>
    <view class="form-row">
      <picker
        class="picker"
        aria-label="选择任务截止日期"
        mode="date"
        value="{{form.dueDate}}"
        data-field="dueDate"
        bindchange="updateField"
      >
        <view class="field picker-field"><text>{{form.dueDate || '选择日期'}}</text><text class="picker-arrow" aria-hidden="true">⌄</text></view>
      </picker>
      <picker
        class="picker"
        aria-label="选择任务截止时间"
        mode="time"
        value="{{form.dueTime}}"
        data-field="dueTime"
        bindchange="updateField"
      >
        <view class="field picker-field"><text>{{form.dueTime}}</text><text class="picker-arrow" aria-hidden="true">⌄</text></view>
      </picker>
    </view>

    <view class="field-label">优先级</view>
    <picker
      aria-label="选择任务优先级，当前为{{priorityLabels[priorityIndex]}}"
      mode="selector"
      range="{{priorityLabels}}"
      value="{{priorityIndex}}"
      bindchange="selectPriority"
    >
      <view class="field picker-field"><text>{{priorityLabels[priorityIndex]}}</text><text class="picker-arrow" aria-hidden="true">⌄</text></view>
    </picker>
    <button class="primary save-button" loading="{{busy}}" disabled="{{!configured || busy}}" bindtap="createTask">确认创建</button>
  </view>

  <view class="section-heading task-section">
    <view class="section-title" aria-role="heading">全部任务</view>
    <view class="section-caption">{{tasks.length ? tasks.length + ' 项' : '保持专注'}}</view>
  </view>
  <view wx:if="{{loading && !error}}" class="loading" aria-live="polite" aria-atomic="true" aria-label="正在加载任务">正在加载任务</view>
  <view wx:elif="{{tasks.length}}">
    <view
      class="card task {{item.completed ? 'completed' : ''}}"

      wx:for="{{tasks}}"
      wx:key="id"
    >
      <view class="task-status {{item.completed ? 'done' : ''}}" aria-hidden="true">{{item.completed ? '✓' : ''}}</view>
      <view class="task-body">
        <view class="row-between task-heading">
          <view class="task-main">
            <view class="card-title task-title">{{item.title}}</view>
            <view class="muted task-meta">{{item.course || '未分课程'}} · 截止 {{item.dueText}}</view>
          </view>
          <view class="task-badges">
            <view class="pill priority-pill {{item.priority === 'high' ? 'danger-pill' : ''}}">{{item.priority === 'high' ? '高优先级' : item.priority === 'low' ? '低优先级' : '中优先级'}}</view>
            <view class="pill status-pill">{{item.statusText}}</view>
          </view>
        </view>
        <button
          wx:if="{{!item.completed && item.status !== 'cancelled'}}"
          class="secondary inline-action complete-button"
          aria-label="将任务{{item.title}}标记为完成"
          data-id="{{item.id}}"
          disabled="{{!configured || busy}}"
          bindtap="completeTask"
        >标记完成</button>
      </view>
    </view>
  </view>
  <view wx:elif="{{!editorOpen}}" class="card empty">
    <view wx:if="{{error}}" aria-label="任务加载失败：{{error}}" aria-live="assertive" aria-atomic="true">
      <view class="empty-icon retry-icon" aria-hidden="true">↻</view>
      <view class="empty-title">暂时无法加载任务</view>
      <view class="empty-copy">{{error}}</view>
      <button class="secondary empty-action" bindtap="retryLoad">重新加载</button>
    </view>
    <block wx:else>
      <view class="empty-icon" aria-hidden="true">✓</view>
      <view class="empty-title">{{configured ? '目前没有任务' : '任务尚未同步'}}</view>
      <view class="empty-copy">{{configured ? '记录下一件要完成的事，让计划更清楚' : '连接服务后显示你的任务清单'}}</view>
      <button wx:if="{{configured}}" class="primary empty-action" bindtap="toggleEditor">新建任务</button>
    </block>
  </view>
</view>