<view class="page">
  <view class="row-between heading">
    <view><view class="page-title">任务清单</view><view class="muted">每次写入都由服务端一次性挑战保护</view></view>
    <button class="primary mini-button" disabled="{{!configured}}" bindtap="toggleEditor">{{editorOpen ? '收起' : '新建'}}</button>
  </view>

  <view wx:if="{{!configured}}" class="banner">配置 HTTPS 服务后才能同步与创建任务。</view>
  <view wx:if="{{error}}" class="banner">{{error}}</view>

  <view wx:if="{{editorOpen}}" class="card editor">
    <view class="card-title">新建任务</view>
    <input class="field" maxlength="200" placeholder="任务标题（必填）" value="{{form.title}}" data-field="title" bindinput="updateField" />
    <input class="field" maxlength="120" placeholder="课程（选填）" value="{{form.course}}" data-field="course" bindinput="updateField" />
    <view class="form-row">
      <picker class="picker" mode="date" value="{{form.dueDate}}" data-field="dueDate" bindchange="updateField">
        <view class="field">{{form.dueDate || '选择截止日期'}}</view>
      </picker>
      <picker class="picker" mode="time" value="{{form.dueTime}}" data-field="dueTime" bindchange="updateField">
        <view class="field">{{form.dueTime}}</view>
      </picker>
    </view>
    <picker mode="selector" range="{{priorityLabels}}" value="{{priorityIndex}}" bindchange="selectPriority">
      <view class="field">优先级：{{priorityLabels[priorityIndex]}}</view>
    </picker>
    <button class="primary save-button" loading="{{busy}}" disabled="{{busy}}" bindtap="createTask">确认创建</button>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载任务…</view>
  <view wx:elif="{{tasks.length}}">
    <view class="card task {{item.completed ? 'completed' : ''}}" wx:for="{{tasks}}" wx:key="id">
      <view class="row-between">
        <view class="task-main">
          <view class="card-title">{{item.title}}</view>
          <view class="muted">{{item.course || '未分课程'}} · 截止 {{item.dueText}}</view>
        </view>
        <view class="pill {{item.priority === 'high' ? 'danger-pill' : ''}}">{{item.statusText}}</view>
      </view>
      <button wx:if="{{!item.completed && item.status !== 'cancelled'}}" class="secondary complete-button" data-id="{{item.id}}" bindtap="completeTask">标记完成</button>
    </view>
  </view>
  <view wx:else class="card empty">{{configured ? '暂无任务，点击右上角新建' : '服务配置后显示任务'}}</view>
</view>
