<view class="voice-page">
  <view class="voice-panel">
    <view class="hero-kicker dark">VOICE CAPTURE</view>
    <view class="voice-title">把想法说出来</view>
    <view class="muted status">{{statusText}}</view>
    <view wx:if="{{!configured}}" class="banner">配置 HTTPS 服务后，可将录音发送到服务端并在停止后识别。</view>
    <view wx:if="{{error}}" class="error-box">{{error}}</view>
    <view class="orb {{phase === 'recording' ? 'active' : ''}}">
      <view class="orb-core">{{phase === 'recording' ? '录' : '声'}}</view>
    </view>
    <button wx:if="{{phase === 'idle'}}" class="primary action" disabled="{{!configured}}" bindtap="start">开始录音</button>
    <button wx:elif="{{phase === 'recording'}}" class="danger action" bindtap="stop">停止并识别</button>
    <button wx:elif="{{phase === 'done'}}" class="secondary action" bindtap="reset">重新录音</button>
    <button wx:else class="secondary action" loading="true" disabled="true">处理中</button>
  </view>
  <view class="transcript-card">
    <view class="row-between"><view class="card-title">识别内容</view><view class="pill">仅当前会话</view></view>
    <view class="transcript {{transcript ? '' : 'muted'}}">{{transcript || '识别结果会显示在这里。离开页面或进入后台时，录音会立即停止且不会自动恢复。'}}</view>
  </view>
</view>
